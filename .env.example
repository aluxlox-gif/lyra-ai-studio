# Application
APP_ENV=development

# LYRA VOICEBOX CLOUD - leave empty until your own Voicebox backend is deployed
VOICEBOX_BASE_URL=
VOICEBOX_API_KEY=
VOICEBOX_API_KEY_HEADER=X-API-Key
VOICEBOX_DEFAULT_PROFILE_ID=
VOICEBOX_TIMEOUT=30

# Comma-separated frontend origins; leave empty for same-origin deployment
CORS_ORIGINS=
