APP_ENV=development

# Existing Voicebox integration
VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_DEFAULT_PROFILE_ID=your_voicebox_profile_id

# Telegram Controller (run as a separate process/service)
LYRA_TELEGRAM_API_TOKEN=replace_with_a_long_random_secret
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Comma-separated numeric Telegram user IDs allowed to use the bot
ADMIN_IDS=123456789
LYRA_API_BASE_URL=https://lyra-ai-studio.vercel.app
LYRA_API_TIMEOUT=12
LOG_LEVEL=INFO

# Hermes Agent (reserved for a later integration phase)
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=your_hermes_api_key
HERMES_MODEL=hermes-agent
HERMES_HEALTH_PATH=/health
LYRA_HERMES_BRIDGE_TOKEN=replace_with_a_long_random_secret

# Frontend CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=
